{
  "name": "agnes-studio",
  "version": "1.1.4",
  "private": true,
  "description": "Agnes 漫剧工坊 · 本地版 — 去掉用户系统与云端依赖的 AI 漫剧制作工作台。项目/剧本/分镜/图片/视频/素材全部留在本机，用户自配 Agnes API Key 驱动。",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test:self": "node tools/selftest.mjs",
    "test:api": "node tools/apitest.mjs",
    "test:ui": "node tools/uitest.mjs",
    "test:browser": "node tools/browser-test.mjs",
    "test": "node tools/run-all.mjs",
    "exe": "node tools/build-exe.mjs"
  },
  "engines": {
    "node": ">=20.6"
  }
}